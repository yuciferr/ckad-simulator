# Dependencies
node_modules/

# TypeScript build output
dist/

# ─── Runtime workspace (sandbox/) ───────────────────────────────────────────
# Entire sandbox is generated at runtime; only README is tracked.
sandbox/*
!sandbox/README.md

# Legacy runtime leak outside sandbox/
etc/

# Local migration backup (never commit)
sandbox-legacy/

# ─── Exam scenarios ─────────────────────────────────────────────────────────
# Do not commit empty scaffolding; add setup.yaml when a scenario is ready.
**/.gitkeep

# ─── OS, editor, env ────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
.env

# Browser automation artifacts
.playwright-mcp/

.agents/
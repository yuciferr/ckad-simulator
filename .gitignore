# Dependencies
node_modules/

# Sandbox runtime state (user-generated, not source)
sandbox/etc/kubernetes/namespace
sandbox/etc/kubernetes/context
sandbox/etc/kubernetes/applied/
sandbox/.bash_history
sandbox/.bash_history_q*
sandbox/.viminfo
sandbox/.local/

# Exam solution files created by user during the exam
# ─── sandbox root: any work files created here ───────────────────────────────
sandbox/*.yaml
sandbox/*.yml
sandbox/*.sh
sandbox/*.json
sandbox/*.txt
sandbox/*.conf
sandbox/*.md

# ─── opt/course: ignore all user solutions, keep only pre-seeded templates ───
# p1: keep only the original deployment template
sandbox/opt/course/p1/*
!sandbox/opt/course/p1/project-23-api.yaml

# p2-p9: keep only README placeholders
sandbox/opt/course/p[2-9]/*
!sandbox/opt/course/p[2-9]/README.txt

# p10-p17: keep only README placeholders
sandbox/opt/course/p1[0-7]/*
!sandbox/opt/course/p1[0-7]/README.txt

# Browser automation artifacts
.playwright-mcp/

# OS & editor
.DS_Store
*.swp
*.swo
.env

#!/bin/bash
# CKAD Simulator — kubectl wrapper
# Safe: help, explain, api-resources, version, --dry-run=client -o yaml
# Simulated: get, describe, create, apply, delete, run, expose, scale, etc.

# Find real kubectl binary (skip our sandbox wrapper)
REAL_KUBECTL=""
IFS=: read -ra _path_dirs <<< "$PATH"
for _dir in "${_path_dirs[@]}"; do
  [[ "$_dir" == "$SANDBOX_ROOT"* ]] && continue
  if [[ -x "$_dir/kubectl" ]]; then
    REAL_KUBECTL="$_dir/kubectl"
    break
  fi
done
SANDBOX_K8S="$SANDBOX_ROOT/etc/kubernetes"
CURRENT_NS_FILE="$SANDBOX_K8S/namespace"
CURRENT_CTX_FILE="$SANDBOX_K8S/context"
APPLIED_DIR="$SANDBOX_K8S/applied"
mkdir -p "$APPLIED_DIR" 2>/dev/null

# Translate sandbox paths (/opt/*, /tmp/*)
_sb_path() {
  case "$1" in
    /opt/*|/tmp/*) echo "${SANDBOX_ROOT}${1}" ;;
    *) echo "$1" ;;
  esac
}

# Real kubeconfig for safe read-only commands (explain, help, dry-run)
_real_kubeconfig() {
  local kc="${REAL_HOME}/.kube/config"
  [[ -f "$kc" ]] && echo "$kc" || echo ""
}

current_ns() { cat "$CURRENT_NS_FILE" 2>/dev/null || echo "default"; }
current_ctx() { cat "$CURRENT_CTX_FILE" 2>/dev/null || echo "kubernetes-admin@kubernetes"; }

# Session state (created resources, exam-scoped mock namespaces)
# shellcheck source=k8s-lib.sh
source "$(dirname "$0")/k8s-lib.sh"

has_flag() {
  for a in "$@"; do
    [[ "$a" == "$1" ]] && return 0
  done
  return 1
}

get_flag_value() {
  local flag="$1"; shift
  while [[ $# -gt 0 ]]; do
    if [[ "$1" == "$flag" && -n "$2" ]]; then echo "$2"; return; fi
    if [[ "$1" == "$flag="* ]]; then echo "${1#*=}"; return; fi
    shift
  done
}

get_namespace() {
  local ns
  ns=$(get_flag_value "-n" "$@")
  [[ -z "$ns" ]] && ns=$(get_flag_value "--namespace" "$@")
  [[ -z "$ns" ]] && ns=$(current_ns)
  echo "$ns"
}

has_dryrun() {
  for a in "$@"; do
    [[ "$a" == "--dry-run"* ]] && return 0
  done
  return 1
}

has_oyaml() {
  local prev=""
  for a in "$@"; do
    [[ "$a" == "-oyaml" || "$a" == "--output=yaml" || "$a" == "-o=yaml" ]] && return 0
    [[ "$prev" == "-o" && "$a" == "yaml" ]] && return 0
    prev="$a"
  done
  return 1
}

get_output_format() {
  local prev=""
  for a in "$@"; do
    [[ "$a" == "-oyaml" || "$a" == "--output=yaml" || "$a" == "-o=yaml" ]] && echo "yaml" && return
    [[ "$a" == "-ojson" || "$a" == "--output=json" || "$a" == "-o=json" ]] && echo "json" && return
    [[ "$a" == "-owide" || "$a" == "--output=wide" || "$a" == "-o=wide" ]] && echo "wide" && return
    [[ "$a" == jsonpath=* ]] && echo "jsonpath" && return
    [[ "$a" == custom-columns=* ]] && echo "custom-columns" && return
    if [[ "$prev" == "-o" ]]; then
      [[ "$a" == wide ]] && echo "wide" && return
      [[ "$a" == jsonpath* ]] && echo "jsonpath" && return
      [[ "$a" == custom-columns* ]] && echo "custom-columns" && return
      echo "$a"
      return
    fi
    prev="$a"
  done
  echo ""
}

has_previous_logs_flag() {
  for a in "$@"; do
    [[ "$a" == "-p" || "$a" == "--previous" ]] && return 0
  done
  return 1
}

# First positional arg after resource type (skip flags and their values)
get_resource_name() {
  local skip_next=false
  for a in "$@"; do
    if $skip_next; then
      skip_next=false
      continue
    fi
    case "$a" in
      -n|-o|--namespace|--output|--context|--field-selector|--label-selector|-l|--sort-by|--kubeconfig|--server|--token|-f|--filename|--watch-only|--limit|--continue|--chunk-size)
        skip_next=true
        continue
        ;;
      --*=*|-*=*)
        continue
        ;;
      -*)
        continue
        ;;
      *)
        echo "$a"
        return
        ;;
    esac
  done
}

# Extract subcommand (first non-flag argument)
subcmd=""
all_args=("$@")
for arg in "$@"; do
  [[ "$arg" == -* ]] && continue
  subcmd="$arg"
  break
done

# ─── Pass-through safe commands to real kubectl if available ──────────────

case "$subcmd" in
  version)
    if [[ -n "$REAL_KUBECTL" ]]; then
      "$REAL_KUBECTL" version --client 2>/dev/null || echo "Client Version: v1.35.0"
    else
      echo "Client Version: v1.35.0"
      echo "Kustomize Version: v5.4.3"
    fi
    exit 0
    ;;

  explain)
    if [[ -n "$REAL_KUBECTL" ]]; then
      HOME="$REAL_HOME" KUBECONFIG="$(_real_kubeconfig)" "$REAL_KUBECTL" "$@" 2>/dev/null
      exit $?
    else
      echo "kubectl explain requires kubectl binary installed locally"
      exit 1
    fi
    ;;

  api-resources)
    if [[ -n "$REAL_KUBECTL" ]]; then
      "$REAL_KUBECTL" api-resources 2>/dev/null
    else
      cat << 'APIEOF'
NAME                              SHORTNAMES   APIVERSION                        NAMESPACED   KIND
bindings                                       v1                                true         Binding
componentstatuses                 cs           v1                                false        ComponentStatus
configmaps                        cm           v1                                true         ConfigMap
endpoints                         ep           v1                                true         Endpoints
events                            ev           v1                                true         Event
limitranges                       limits       v1                                true         LimitRange
namespaces                        ns           v1                                false        Namespace
nodes                             no           v1                                false        Node
persistentvolumeclaims            pvc          v1                                true         PersistentVolumeClaim
persistentvolumes                 pv           v1                                false        PersistentVolume
pods                              po           v1                                true         Pod
replicationcontrollers            rc           v1                                true         ReplicationController
resourcequotas                    quota        v1                                true         ResourceQuota
secrets                                        v1                                true         Secret
serviceaccounts                   sa           v1                                true         ServiceAccount
services                          svc          v1                                true         Service
cronjobs                          cj           batch/v1                          true         CronJob
jobs                                           batch/v1                          true         Job
daemonsets                        ds           apps/v1                           true         DaemonSet
deployments                       deploy       apps/v1                           true         Deployment
replicasets                       rs           apps/v1                           true         ReplicaSet
statefulsets                      sts          apps/v1                           true         StatefulSet
ingresses                         ing          networking.k8s.io/v1             true         Ingress
networkpolicies                   netpol       networking.k8s.io/v1             true         NetworkPolicy
clusterrolebindings                            rbac.authorization.k8s.io/v1     false        ClusterRoleBinding
clusterroles                                   rbac.authorization.k8s.io/v1     false        ClusterRole
rolebindings                                   rbac.authorization.k8s.io/v1     true         RoleBinding
roles                                          rbac.authorization.k8s.io/v1     true         Role
APIEOF
    fi
    exit 0
    ;;

  api-versions)
    cat << 'EOF'
admissionregistration.k8s.io/v1
apps/v1
autoscaling/v1
autoscaling/v2
batch/v1
certificates.k8s.io/v1
coordination.k8s.io/v1
discovery.k8s.io/v1
events.k8s.io/v1
networking.k8s.io/v1
node.k8s.io/v1
policy/v1
rbac.authorization.k8s.io/v1
scheduling.k8s.io/v1
storage.k8s.io/v1
v1
EOF
    exit 0
    ;;
esac

# ─── Help flags → pass to real kubectl or show generic help ───────────────

for arg in "$@"; do
  if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
    if [[ -n "$REAL_KUBECTL" ]]; then
      HOME="$REAL_HOME" KUBECONFIG="$(_real_kubeconfig)" "$REAL_KUBECTL" "$@" 2>/dev/null
      exit $?
    else
      echo "kubectl controls the Kubernetes cluster manager."
      echo ""
      echo "Usage: kubectl [command] [flags]"
      echo ""
      echo "Basic Commands:"
      echo "  create, get, run, expose, delete, apply, edit, scale, rollout"
      echo ""
      echo "Use \"kubectl <command> --help\" for more information."
      exit 0
    fi
  fi
done

# ─── Dry-run → real kubectl (offline kubeconfig prevents any cluster contact) ──
# --dry-run=client is CLIENT-SIDE only, but we use an empty kubeconfig to be safe.

if has_dryrun "$@" && [[ "$subcmd" == "run" || "$subcmd" == "create" ]]; then
  gen_dryrun_yaml "$@"
  exit $?
fi

# ─── Config commands ──────────────────────────────────────────────────────

if [[ "$subcmd" == "config" ]]; then
  shift
  config_sub="$1"; shift
  case "$config_sub" in
    set-context)
      ns_val=$(get_flag_value "--namespace" "$@")
      if [[ -n "$ns_val" ]]; then
        echo "$ns_val" > "$CURRENT_NS_FILE"
        echo "Context \"$(current_ctx)\" modified."
      else
        echo "Context \"$(current_ctx)\" modified."
      fi
      ;;
    current-context)
      current_ctx
      ;;
    get-contexts)
      echo "CURRENT   NAME                          CLUSTER      AUTHINFO           NAMESPACE"
      echo "*         $(current_ctx)   kubernetes   kubernetes-admin   $(current_ns)"
      ;;
    use-context)
      ctx="$1"
      [[ -n "$ctx" ]] && echo "$ctx" > "$CURRENT_CTX_FILE"
      echo "Switched to context \"${ctx:-$(current_ctx)}\"."
      ;;
    *)
      echo "Unknown config subcommand: $config_sub"
      ;;
  esac
  exit 0
fi

# ─── Rollout commands ─────────────────────────────────────────────────────

if [[ "$subcmd" == "rollout" ]]; then
  shift; rollout_sub="$1"; shift
  ns=$(get_namespace "$@")
  
  # Parse RESOURCE/NAME format (handles both "deployment/name" and "name" formats)
  roll_res=""
  roll_name=""
  case "$1" in
    deployment/*|deploy/*)
      roll_res="deployment"
      roll_name="${1#*/}"
      shift
      ;;
    statefulset/*|sts/*)
      roll_res="statefulset"
      roll_name="${1#*/}"
      shift
      ;;
    daemonset/*|ds/*)
      roll_res="daemonset"
      roll_name="${1#*/}"
      shift
      ;;
    *)
      roll_name="$1"
      shift
      ;;
  esac
  
  [[ -z "$roll_name" ]] && roll_name="${2:-}"
  
  case "$rollout_sub" in
    status)
      # Check if deployment exists
      if [[ -n "$roll_name" && -f "$(session_ns_dir "$ns")/deploy.txt" ]] && \
         command grep -q "^${roll_name}[[:space:]]" "$(session_ns_dir "$ns")/deploy.txt" 2>/dev/null; then
        echo "Waiting for rollout to complete: deployment/${roll_name}"
        echo "replicas 1 -> 1"
        echo "deployment \"${roll_name}\" successfully rolled out"
      elif [[ -z "$roll_name" ]]; then
        echo "error: RESOURCE is required" >&2
        exit 1
      else
        echo "error: resource \"deployment\" \"${roll_name}\" not found" >&2
        exit 1
      fi
      ;;
    history)
      if [[ -z "$roll_name" ]]; then
        echo "error: RESOURCE is required" >&2
        exit 1
      fi
      echo "deployment.apps/${roll_name}"
      echo "REVISION  CHANGE-CAUSE"
      # Check for revision file (could store multiple revisions)
      rev_file="$(session_ns_dir "$ns")/rev-${roll_name}.meta"
      if [[ -f "$rev_file" ]]; then
        cat "$rev_file"
      else
        echo "1         <none>"
      fi
      ;;
    undo)
      if [[ -z "$roll_name" ]]; then
        echo "error: RESOURCE is required" >&2
        exit 1
      fi
      echo "deployment.apps/${roll_name} rolled back"
      ;;
    restart)
      if [[ -z "$roll_name" ]]; then
        echo "error: RESOURCE is required" >&2
        exit 1
      fi
      echo "deployment.apps/${roll_name} restarted"
      ;;
    pause)
      if [[ -z "$roll_name" ]]; then
        echo "error: RESOURCE is required" >&2
        exit 1
      fi
      echo "deployment.apps/${roll_name} paused"
      ;;
    resume)
      if [[ -z "$roll_name" ]]; then
        echo "error: RESOURCE is required" >&2
        exit 1
      fi
      echo "deployment.apps/${roll_name} resumed"
      ;;
    *)
      echo "error: unknown rollout subcommand \"$rollout_sub\"" >&2
      echo "Usage: kubectl rollout SUBCOMMAND (RESOURCE)" >&2
      exit 1
      ;;
  esac
  exit 0
fi

# ─── Namespace extraction for simulated commands ──────────────────────────

ns=$(get_namespace "$@")

# ─── Simulated kubectl commands ───────────────────────────────────────────

case "$subcmd" in
  get)
    shift; resource="$1"; shift
    # Normalize resource aliases
    case "$resource" in
      pod|po|pods) resource_file="pods"; resource_kind="Pod"; resource_api="v1" ;;
      deployment|deploy|deployments) resource_file="deploy"; resource_kind="Deployment"; resource_api="apps/v1" ;;
      service|svc|services) resource_file="services"; resource_kind="Service"; resource_api="v1" ;;
      configmap|cm|configmaps) resource_file="configmaps"; resource_kind="ConfigMap"; resource_api="v1" ;;
      secret|secrets) resource_file="secrets"; resource_kind="Secret"; resource_api="v1" ;;
      ingress|ing|ingresses) resource_file="ingresses"; resource_kind="Ingress"; resource_api="networking.k8s.io/v1" ;;
      pvc|persistentvolumeclaim) resource_file="pvc"; resource_kind="PersistentVolumeClaim"; resource_api="v1" ;;
      pv|persistentvolume) resource_file="pv"; resource_kind="PersistentVolume"; resource_api="v1" ;;
      node|no|nodes) resource_file="nodes"; resource_kind="Node"; resource_api="v1" ;;
      namespace|ns|namespaces) resource_file="namespaces"; resource_kind="Namespace"; resource_api="v1" ;;
      job|jobs) resource_file="jobs"; resource_kind="Job"; resource_api="batch/v1" ;;
      cronjob|cj|cronjobs) resource_file="cronjobs"; resource_kind="CronJob"; resource_api="batch/v1" ;;
      daemonset|ds|daemonsets) resource_file="daemonsets"; resource_kind="DaemonSet"; resource_api="apps/v1" ;;
      replicaset|rs|replicasets) resource_file="replicasets"; resource_kind="ReplicaSet"; resource_api="apps/v1" ;;
      statefulset|sts|statefulsets) resource_file="statefulsets"; resource_kind="StatefulSet"; resource_api="apps/v1" ;;
      networkpolicy|netpol|networkpolicies) resource_file="networkpolicies"; resource_kind="NetworkPolicy"; resource_api="networking.k8s.io/v1" ;;
      sa|serviceaccount|serviceaccounts) resource_file="serviceaccounts"; resource_kind="ServiceAccount"; resource_api="v1" ;;
      resourcequota|quota|resourcequotas) resource_file="resourcequotas"; resource_kind="ResourceQuota"; resource_api="v1" ;;
      *) resource_file="$resource"; resource_kind="$resource"; resource_api="v1" ;;
    esac

    # Extract specific resource name (skip flags like -n pluto, -o yaml)
    res_name=$(get_resource_name "$@")

    out_fmt=$(get_output_format "${all_args[@]}")

    # jsonpath output for session pods
    if [[ "$out_fmt" == "jsonpath" && "$resource_file" == "pods" ]]; then
      jp_template=$(get_jsonpath_template "${all_args[@]}")
      if [[ -n "$res_name" ]] && ( pod_exists "$ns" "$res_name" || mock_pod_exists "$ns" "$res_name" ); then
        eval_pod_jsonpath "$ns" "$res_name" "$jp_template"
        echo
        exit 0
      fi
      if [[ -z "$res_name" ]]; then
        label_sel=$(get_flag_value "-l" "${all_args[@]}")
        eval_pods_list_jsonpath "$ns" "$jp_template" "$label_sel"
        exit 0
      fi
    fi

    # custom-columns output for pods
    if [[ "$out_fmt" == "custom-columns" && "$resource_file" == "pods" && -n "$res_name" ]]; then
      col_spec=$(get_custom_columns_spec "${all_args[@]}")
      if pod_exists "$ns" "$res_name" || mock_pod_exists "$ns" "$res_name"; then
        render_pod_custom_columns "$ns" "$res_name" "$col_spec"
        exit 0
      fi
    fi

    # If a specific resource name + YAML output requested, serve YAML
    if [[ -n "$res_name" && ( "$out_fmt" == "yaml" || "$out_fmt" == "json" ) ]]; then
      if [[ "$resource_file" == "pods" ]] && pod_exists "$ns" "$res_name"; then
        render_pod_yaml "$ns" "$res_name"
        exit 0
      fi

      # 1. Check for a dedicated mock YAML file
      yaml_mock="$SANDBOX_K8S/mock/${ns}/${resource_file}-${res_name}.yaml"
      if [[ -f "$yaml_mock" ]]; then
        cat "$yaml_mock"
        exit 0
      fi

      # 2. Check applied dir for a matching file
      for f in "$APPLIED_DIR"/*; do
        [[ -f "$f" ]] || continue
        f_name=$(command grep -m1 'name:' "$f" 2>/dev/null | awk '{print $2}')
        f_kind=$(command grep -m1 'kind:' "$f" 2>/dev/null | awk '{print $2}')
        if [[ "$f_name" == "$res_name" ]]; then
          cat "$f"
          exit 0
        fi
      done

      # 3. Check /opt/course directories for matching YAML
      if [[ -d "$SANDBOX_ROOT/opt/course" ]]; then
        while IFS= read -r -d '' yf; do
          yf_name=$(command grep -m1 'name:' "$yf" 2>/dev/null | awk '{print $2}')
          if [[ "$yf_name" == "$res_name" ]]; then
            cat "$yf"
            exit 0
          fi
        done < <(find "$SANDBOX_ROOT/opt/course" -name '*.yaml' -o -name '*.yml' | tr '\n' '\0')
      fi

      # 4. Generate minimal synthetic YAML
      cat <<YAMLEOF
apiVersion: $resource_api
kind: $resource_kind
metadata:
  name: $res_name
  namespace: $ns
  creationTimestamp: "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  labels:
    app: $res_name
spec: {}
YAMLEOF
      exit 0
    fi

    # If a specific resource name but table/wide output
    if [[ -n "$res_name" && ( -z "$out_fmt" || "$out_fmt" == "wide" ) ]]; then
      found=false
      if [[ "$resource_file" == "pods" && "$out_fmt" == "wide" ]] && pod_exists "$ns" "$res_name"; then
        echo "NAME                              READY   STATUS    RESTARTS   AGE    IP            NODE"
        format_pod_wide_row "$ns" "$res_name"
        exit 0
      fi
      if has_watch_flag "${all_args[@]}" && [[ "$resource_file" == "pods" ]] && pod_exists "$ns" "$res_name"; then
        echo "NAME                              READY   STATUS    RESTARTS   AGE"
        sync_pod_table_line "$ns" "$res_name"
        echo
        exit 0
      fi
      if get_resource_list "$ns" "$resource_file" 2>/dev/null | { head -1; command grep -i "^${res_name}[[:space:]]"; } | tail -n +2 | grep -q .; then
        get_resource_list "$ns" "$resource_file" | head -1
        get_resource_list "$ns" "$resource_file" | command grep -i "^${res_name}[[:space:]]"
        found=true
      elif is_mock_namespace_enabled "$ns"; then
        mock_file="$SANDBOX_K8S/mock/${ns}/${resource_file}.txt"
        if [[ -f "$mock_file" ]]; then
          head -1 "$mock_file"
          command grep -i "^${res_name}[[:space:]]" "$mock_file" || echo "Error from server (NotFound): ${resource_kind} \"${res_name}\" not found"
          found=true
        fi
      fi
      if ! $found; then
        echo "Error from server (NotFound): ${resource_kind} \"${res_name}\" not found"
      fi
      exit 0
    fi

    # All-namespaces list mode
    if has_all_namespaces "${all_args[@]}"; then
      case "$resource" in
        pods|pod|po)
          list_all_namespaces_pods
          ;;
        namespaces|namespace|ns)
          echo "NAME              STATUS   AGE"
          while IFS= read -r ns_name; do
            printf '%-17s Active   30d\n' "$ns_name"
          done < <(list_visible_namespaces | sort -u)
          ;;
        *)
          echo "No resources found"
          ;;
      esac
      exit 0
    fi

    # List mode (no specific name)
    if [[ "$resource_file" == "pods" && "$out_fmt" == "wide" ]]; then
      if list_session_pods_wide "$ns"; then
        exit 0
      fi
    fi

    if get_resource_list "$ns" "$resource_file"; then
      :
    else
      case "$resource" in
        pods|pod|po)
          if [[ "$out_fmt" == "wide" ]]; then
            echo "NAME                              READY   STATUS    RESTARTS   AGE    IP            NODE"
          else
            echo "NAME                              READY   STATUS    RESTARTS   AGE"
          fi
          echo "No resources found in $ns namespace."
          ;;
        deployments|deployment|deploy)
          echo "NAME   READY   UP-TO-DATE   AVAILABLE   AGE"
          echo "No resources found in $ns namespace."
          ;;
        services|service|svc)
          echo "NAME         TYPE        CLUSTER-IP   EXTERNAL-IP   PORT(S)   AGE"
          if is_mock_namespace_enabled "$ns" && [[ -f "$SANDBOX_K8S/mock/${ns}/services.txt" ]]; then
            cat "$SANDBOX_K8S/mock/${ns}/services.txt"
          else
            echo "kubernetes   ClusterIP   10.96.0.1    <none>        443/TCP   30d"
          fi
          ;;
        namespaces|namespace|ns)
          echo "NAME              STATUS   AGE"
          while IFS= read -r ns_name; do
            printf '%-17s Active   30d\n' "$ns_name"
          done < <(list_visible_namespaces | sort -u)
          ;;
        nodes|node|no)
          echo "NAME         STATUS   ROLES           AGE   VERSION"
          echo "ckad9043     Ready    control-plane   30d   v1.35.0"
          echo "ckad5601     Ready    <none>          30d   v1.35.0"
          ;;
        all)
          echo "NAME                              READY   STATUS    RESTARTS   AGE"
          echo ""
          echo "NAME         TYPE        CLUSTER-IP   EXTERNAL-IP   PORT(S)   AGE"
          echo "kubernetes   ClusterIP   10.96.0.1    <none>        443/TCP   30d"
          ;;
        *)
          echo "No resources found in $ns namespace."
          ;;
      esac
    fi
    ;;

  describe)
    shift; resource="$1"; name="$2"; shift 2
    case "$resource" in
      pod|po|pods)
        if pod_exists "$ns" "$name"; then
          render_pod_describe "$ns" "$name"
          exit 0
        fi
        ;;
      deploy|deployment|deployments)
        if [[ -f "$(session_ns_dir "$ns")/deploy.txt" ]] && command grep -q "^${name}[[:space:]]" "$(session_ns_dir "$ns")/deploy.txt" 2>/dev/null; then
          echo "Name:         ${name}"
          echo "Namespace:    $ns"
          echo "Labels:       app=${name}"
          echo "Replicas:     1 desired | 1 updated | 1 total | 1 available | 0 unavailable"
          exit 0
        fi
        ;;
      svc|service|services)
        if [[ -f "$(session_ns_dir "$ns")/services.txt" ]] && command grep -q "^${name}[[:space:]]" "$(session_ns_dir "$ns")/services.txt" 2>/dev/null; then
          echo "Name:         ${name}"
          echo "Namespace:    $ns"
          echo "Labels:       app=${name}"
          echo "Type:         ClusterIP"
          echo "Endpoints:    10.244.0.1:80"
          exit 0
        fi
        ;;
      cm|configmap|configmaps)
        if [[ -f "$(session_ns_dir "$ns")/configmaps.txt" ]] && command grep -q "^${name}[[:space:]]" "$(session_ns_dir "$ns")/configmaps.txt" 2>/dev/null; then
          echo "Name:         ${name}"
          echo "Namespace:    $ns"
          echo "Data:         key"
          exit 0
        fi
        ;;
      secret|secrets)
        if [[ -f "$(session_ns_dir "$ns")/secrets.txt" ]] && command grep -q "^${name}[[:space:]]" "$(session_ns_dir "$ns")/secrets.txt" 2>/dev/null; then
          echo "Name:         ${name}"
          echo "Namespace:    $ns"
          echo "Type:         Opaque"
          exit 0
        fi
        ;;
      pvc|persistentvolumeclaim)
        if [[ -f "$(session_ns_dir "$ns")/pvc.txt" ]] && command grep -q "^${name}[[:space:]]" "$(session_ns_dir "$ns")/pvc.txt" 2>/dev/null; then
          echo "Name:         ${name}"
          echo "Namespace:    $ns"
          echo "Status:       Bound"
          exit 0
        fi
        ;;
    esac
    mock_file="$SANDBOX_K8S/mock/${ns}/describe-${resource}-${name}.txt"
    if [[ -f "$mock_file" ]]; then
      cat "$mock_file"
    else
      echo "Name:         ${name:-unknown}"
      echo "Namespace:    $ns"
      echo "Labels:       app=$name"
      echo "Status:       Running"
    fi
    ;;

  create)
    shift
    # Handle special create subcommands
    case "$1" in
      deployment|deploy)
        deploy_ns=$(get_namespace "$@")
        deploy_name="${2:-}"
        
        if [[ -z "$deploy_name" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        
        add_deploy_to_session "$deploy_ns" "$deploy_name"
        echo "deployment.apps/${deploy_name} created"
        ;;
      service|svc)
        svc_ns=$(get_namespace "$@")
        svc_name="${2:-}"
        
        if [[ -z "$svc_name" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        
        # Generate pseudo-cluster IP
        sv_hash=$(printf '%s' "$svc_name" | cksum | awk '{print $1}')
        cl_ip="10.96.$(((sv_hash % 250) + 1)).$(((sv_hash / 250 % 250) + 1))"
        
        add_list_resource_to_session "$svc_ns" "services" "$svc_name" \
          "$(printf '%-20s %-11s %-15s %-13s %-9s %s' "$svc_name" "ClusterIP" "$cl_ip" "<none>" "80/TCP" "30s")"
        echo "service/${svc_name} created"
        ;;
      job)
        job_nm="${2:-}"
        if [[ -z "$job_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        echo "job.batch/${job_nm} created"
        ;;
      cronjob|cj)
        cj_nm="${2:-}"
        if [[ -z "$cj_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        echo "cronjob.batch/${cj_nm} created"
        ;;
      configmap|cm)
        cm_nm="${2:-}"
        if [[ -z "$cm_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        echo "configmap/${cm_nm} created"
        ;;
      secret)
        sec_nm="${3:-${2:-}}"
        if [[ -z "$sec_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        echo "secret/${sec_nm} created"
        ;;
      sa|serviceaccount)
        sa_nm="${2:-}"
        if [[ -z "$sa_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        add_list_resource_to_session "$(get_namespace "$@")" "serviceaccounts" "$sa_nm" \
          "$(printf '%-20s %-5s %s' "$sa_nm" "0" "30s")"
        echo "serviceaccount/${sa_nm} created"
        ;;
      role)
        rl_nm="${2:-}"
        if [[ -z "$rl_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        echo "role.rbac.authorization.k8s.io/${rl_nm} created"
        ;;
      rolebinding)
        rb_nm="${2:-}"
        if [[ -z "$rb_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        echo "rolebinding.rbac.authorization.k8s.io/${rb_nm} created"
        ;;
      clusterrole)
        cr_nm="${2:-}"
        if [[ -z "$cr_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        echo "clusterrole.rbac.authorization.k8s.io/${cr_nm} created"
        ;;
      clusterrolebinding)
        crb_nm="${2:-}"
        if [[ -z "$crb_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        echo "clusterrolebinding.rbac.authorization.k8s.io/${crb_nm} created"
        ;;
      ingress|ing)
        ing_nm="${2:-}"
        if [[ -z "$ing_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        add_list_resource_to_session "$(get_namespace "$@")" "ingresses" "$ing_nm" \
          "$(printf '%-20s %-10s %-20s %-15s %-10s %s' "$ing_nm" "nginx" "*" "<none>" "80,443" "30s")"
        echo "ingress.networking.k8s.io/${ing_nm} created"
        ;;
      namespace|ns)
        ns_nm="${2:-}"
        if [[ -z "$ns_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        
        # Protected namespace check
        if [[ "$ns_nm" == "kube-system" || "$ns_nm" == "kube-public" || "$ns_nm" == "kube-node-lease" ]]; then
          echo "error: Forbidden: namespace \"${ns_nm}\" is protected" >&2
          exit 1
        fi
        
        echo "namespace/${ns_nm} created"
        ensure_session_ns "$ns_nm"
        ;;
      resourcequota|quota)
        rq_nm="${2:-}"
        if [[ -z "$rq_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        echo "resourcequota/${rq_nm} created"
        ;;
      pvc|persistentvolumeclaim)
        pvc_nm="${2:-}"
        if [[ -z "$pvc_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        add_list_resource_to_session "$(get_namespace "$@")" "pvc" "$pvc_nm" \
          "$(printf '%-20s %-10s %-15s %-15s %-15s %-15s %s' "$pvc_nm" "Pending" "<none>" "1Gi" "RWO" "standard" "30s")"
        echo "persistentvolumeclaim/${pvc_nm} created"
        ;;
      networkpolicy|netpol)
        netpol_nm="${2:-}"
        if [[ -z "$netpol_nm" ]]; then
          echo "error: missing required argument 'name'" >&2
          exit 1
        fi
        add_list_resource_to_session "$(get_namespace "$@")" "networkpolicies" "$netpol_nm" \
          "$(printf '%-20s %-15s %s' "$netpol_nm" "<全部>" "30s")"
        echo "networkpolicy.networking.k8s.io/${netpol_nm} created"
        ;;
      -f|--filename)
        file_flag=$(_sb_path "$(get_flag_value "-f" "$@")")
        if [[ -n "$file_flag" && -f "$file_flag" ]]; then
          dest="$APPLIED_DIR/$(basename "$file_flag")"
          command cp "$file_flag" "$dest" 2>/dev/null
          register_resource_from_yaml "$dest"
          kind=$(command grep -m1 '^kind:' "$file_flag" 2>/dev/null | awk '{print $2}')
          name_val=$(command grep -m1 '^  name:' "$file_flag" 2>/dev/null | awk '{print $2}')
          [[ -z "$name_val" ]] && name_val=$(command grep -m1 '^name:' "$file_flag" 2>/dev/null | awk '{print $2}')
          
          # Proper output format
          case "$kind" in
            Deployment) echo "deployment.apps/${name_val:-unnamed} created" ;;
            Service) echo "service/${name_val:-unnamed} created" ;;
            ConfigMap) echo "configmap/${name_val:-unnamed} created" ;;
            Secret) echo "secret/${name_val:-unnamed} created" ;;
            Ingress) echo "ingress.networking.k8s.io/${name_val:-unnamed} created" ;;
            PersistentVolumeClaim) echo "persistentvolumeclaim/${name_val:-unnamed} created" ;;
            NetworkPolicy) echo "networkpolicy.networking.k8s.io/${name_val:-unnamed} created" ;;
            CronJob) echo "cronjob.batch/${name_val:-unnamed} created" ;;
            Job) echo "job.batch/${name_val:-unnamed} created" ;;
            Pod) echo "pod/${name_val:-unnamed} created" ;;
            Namespace) echo "namespace/${name_val:-unnamed} created" ;;
            Role) echo "role.rbac.authorization.k8s.io/${name_val:-unnamed} created" ;;
            RoleBinding) echo "rolebinding.rbac.authorization.k8s.io/${name_val:-unnamed} created" ;;
            ClusterRole) echo "clusterrole.rbac.authorization.k8s.io/${name_val:-unnamed} created" ;;
            ClusterRoleBinding) echo "clusterrolebinding.rbac.authorization.k8s.io/${name_val:-unnamed} created" ;;
            ServiceAccount) echo "serviceaccount/${name_val:-unnamed} created" ;;
            *) echo "${kind:-resource}/${name_val:-unnamed} created" ;;
          esac
        else
          echo "error: error reading file \"${file_flag}\": no such file or directory" >&2
          exit 1
        fi
        ;;
      *)
        # Check if unrecognized but sounds like a resource
        if [[ -n "$1" ]]; then
          echo "error: unknown resource type \"$1\"" >&2
          exit 1
        fi
        echo "error: you must specify a resource type" >&2
        exit 1
        ;;
    esac
    ;;

  apply)
    file_flag=$(_sb_path "$(get_flag_value "-f" "$@")")
    if [[ -n "$file_flag" && -f "$file_flag" ]]; then
      dest="$APPLIED_DIR/$(basename "$file_flag")"
      command cp "$file_flag" "$dest" 2>/dev/null
      register_resource_from_yaml "$dest"
      kind=$(command grep -m1 '^kind:' "$file_flag" 2>/dev/null | awk '{print $2}')
      name_val=$(command grep -m1 '^  name:' "$file_flag" 2>/dev/null | awk '{print $2}')
      [[ -z "$name_val" ]] && name_val=$(command grep -m1 '^name:' "$file_flag" 2>/dev/null | awk '{print $2}')
      
      # Proper Kubernetes-formatted output
      case "$kind" in
        Deployment)
          echo "deployment.apps/${name_val:-unnamed} created"
          ;;
        Service)
          echo "service/${name_val:-unnamed} created"
          ;;
        ConfigMap)
          echo "configmap/${name_val:-unnamed} created"
          ;;
        Secret)
          echo "secret/${name_val:-unnamed} created"
          ;;
        Ingress)
          echo "ingress.networking.k8s.io/${name_val:-unnamed} created"
          ;;
        PersistentVolumeClaim)
          echo "persistentvolumeclaim/${name_val:-unnamed} created"
          ;;
        Job)
          echo "job.batch/${name_val:-unnamed} created"
          ;;
        CronJob)
          echo "cronjob.batch/${name_val:-unnamed} created"
          ;;
        Pod)
          echo "pod/${name_val:-unnamed} created"
          ;;
        Namespace)
          echo "namespace/${name_val:-unnamed} created"
          ;;
        Role|RoleBinding|ClusterRole|ClusterRoleBinding)
          echo "${kind,,}.rbac.authorization.k8s.io/${name_val:-unnamed} created"
          ;;
        *)
          echo "${kind:-resource}/${name_val:-unnamed} created"
          ;;
      esac
    else
      echo "error: must specify -f or --filename" >&2
      exit 1
    fi
    ;;

  delete)
    shift; resource="$1"; name="$2"
    del_ns=$(get_namespace "${all_args[@]}")
    
    # Validation: check if resource type is valid
    case "$resource" in
      pod|po|pods|deployment|deploy|deployments|service|svc|services|\
        configmap|cm|configmaps|secret|secrets|ingress|ing|ingresses|\
        pvc|persistentvolumeclaim|job|jobs|cronjob|cj|cronjobs|\
        namespace|ns|namespaces|networkpolicy|netpol|networkpolicies|\
        sa|serviceaccount|serviceaccounts|role|rolebinding|\
        clusterrole|clusterrolebinding|hpa|horizontalpodautoscaler|\
        rs|replicaset|replicasets|sts|statefulset|statefulsets|\
        ds|daemonset|daemonsets)
        ;;
      -f|--filename)
        # File-based delete
        del_file=$(_sb_path "$(get_flag_value "-f" "$@")")
        if [[ -n "$del_file" && -f "$del_file" ]]; then
          del_kind=$(command grep -m1 '^kind:' "$del_file" 2>/dev/null | awk '{print $2}')
          del_name=$(command grep -m1 '^  name:' "$del_file" 2>/dev/null | awk '{print $2}')
          [[ -z "$del_name" ]] && del_name=$(command grep -m1 '^name:' "$del_file" 2>/dev/null | awk '{print $2}')
          
          case "$del_kind" in
            Pod)
              if pod_exists "$del_ns" "$del_name"; then
                delete_pod_from_session "$del_ns" "$del_name"
              fi
              ;;
          esac
          
          # Remove from applied dir
          rm -f "$APPLIED_DIR/$(basename "$del_file")" 2>/dev/null
          echo "${del_kind:-resource}/${del_name:-unnamed} deleted"
        else
          echo "error: error reading file \"${del_file}\": no such file or directory" >&2
          exit 1
        fi
        exit 0
        ;;
      "")
        echo "error: RESOURCE is required" >&2
        echo "See 'kubectl delete --help' for usage." >&2
        exit 1
        ;;
      *)
        echo "error: the server doesn't have a resource type \"$resource\"" >&2
        exit 1
        ;;
    esac
    
    # Check resource exists and delete it
    deleted=false
    case "$resource" in
      pod|po|pods)
        if pod_exists "$del_ns" "$name"; then
          delete_pod_from_session "$del_ns" "$name"
          deleted=true
        elif mock_pod_exists "$del_ns" "$name"; then
          deleted=true
        fi
        if $deleted; then
          echo "pod \"${name}\" deleted"
        else
          echo "error: resource \"pod\" \"${name}\" not found" >&2
          exit 1
        fi
        ;;
      deployment|deploy|deployments)
        deploy_file="$(session_ns_dir "$del_ns")/deploy.txt"
        if [[ -f "$deploy_file" ]] && command grep -q "^${name}[[:space:]]" "$deploy_file" 2>/dev/null; then
          command grep -vi "^${name}[[:space:]]" "$deploy_file" > "${deploy_file}.tmp" 2>/dev/null || true
          head -1 "$deploy_file" > "${deploy_file}.clean"
          tail -n +2 "${deploy_file}.tmp" >> "${deploy_file}.clean" 2>/dev/null || true
          mv "${deploy_file}.clean" "$deploy_file"
          rm -f "${deploy_file}.tmp"
          deleted=true
        fi
        if $deleted; then
          echo "deployment.apps \"${name}\" deleted"
        else
          echo "error: resource \"deployment\" \"${name}\" not found" >&2
          exit 1
        fi
        ;;
      service|svc|services)
        svc_file="$(session_ns_dir "$del_ns")/services.txt"
        if [[ -f "$svc_file" ]] && command grep -q "^${name}[[:space:]]" "$svc_file" 2>/dev/null; then
          command grep -vi "^${name}[[:space:]]" "$svc_file" > "${svc_file}.tmp" 2>/dev/null || true
          head -1 "$svc_file" > "${svc_file}.clean"
          tail -n +2 "${svc_file}.tmp" >> "${svc_file}.clean" 2>/dev/null || true
          mv "${svc_file}.clean" "$svc_file"
          rm -f "${svc_file}.tmp"
          deleted=true
        fi
        if $deleted; then
          echo "service \"${name}\" deleted"
        else
          echo "error: resource \"service\" \"${name}\" not found" >&2
          exit 1
        fi
        ;;
      configmap|cm|configmaps)
        cm_file="$(session_ns_dir "$del_ns")/configmaps.txt"
        if [[ -f "$cm_file" ]] && command grep -q "^${name}[[:space:]]" "$cm_file" 2>/dev/null; then
          command grep -vi "^${name}[[:space:]]" "$cm_file" > "${cm_file}.tmp" 2>/dev/null || true
          head -1 "$cm_file" > "${cm_file}.clean"
          tail -n +2 "${cm_file}.tmp" >> "${cm_file}.clean" 2>/dev/null || true
          mv "${cm_file}.clean" "$cm_file"
          rm -f "${cm_file}.tmp"
          deleted=true
        fi
        if $deleted; then
          echo "configmap \"${name}\" deleted"
        else
          echo "error: resource \"configmap\" \"${name}\" not found" >&2
          exit 1
        fi
        ;;
      secret|secrets)
        sec_file="$(session_ns_dir "$del_ns")/secrets.txt"
        if [[ -f "$sec_file" ]] && command grep -q "^${name}[[:space:]]" "$sec_file" 2>/dev/null; then
          command grep -vi "^${name}[[:space:]]" "$sec_file" > "${sec_file}.tmp" 2>/dev/null || true
          head -1 "$sec_file" > "${sec_file}.clean"
          tail -n +2 "${sec_file}.tmp" >> "${sec_file}.clean" 2>/dev/null || true
          mv "${sec_file}.clean" "$sec_file"
          rm -f "${sec_file}.tmp"
          deleted=true
        fi
        if $deleted; then
          echo "secret \"${name}\" deleted"
        else
          echo "error: resource \"secret\" \"${name}\" not found" >&2
          exit 1
        fi
        ;;
      namespace|ns|namespaces)
        if [[ "$name" == "kube-system" || "$name" == "kube-public" || "$name" == "kube-node-lease" ]]; then
          echo "error: namespaces \"${name}\" is protected" >&2
          exit 1
        fi
        if [[ -f "${SESSION_DIR}/namespaces.txt" ]]; then
          if command grep -qxF "$name" "${SESSION_DIR}/namespaces.txt" 2>/dev/null; then
            command grep -xvF "$name" "${SESSION_DIR}/namespaces.txt" > "${SESSION_DIR}/namespaces.txt.tmp" 2>/dev/null || true
            mv "${SESSION_DIR}/namespaces.txt.tmp" "${SESSION_DIR}/namespaces.txt"
            rm -rf "$(session_ns_dir "$name")" 2>/dev/null
            echo "namespace \"${name}\" deleted"
          else
            echo "error: resource \"namespace\" \"${name}\" not found" >&2
            exit 1
          fi
        fi
        ;;
      *)
        echo "\"${name}\" deleted"
        ;;
    esac
    ;;

  run)
    # Find operand from all_args
    pod_name=""
    for arg in "${all_args[@]}"; do
      [[ "$arg" == "run" ]] && continue
      case "$arg" in
        -*) continue ;;
      esac
      if [[ -z "$pod_name" ]]; then
        pod_name="$arg"
        break
      fi
    done
    
    if [[ -z "$pod_name" ]]; then
      echo "error: required 'pod' resource was not passed completely" >&2
      exit 1
    fi
    
    run_ns=$(get_namespace "${all_args[@]}")
    has_rm=false
    for a in "${all_args[@]}"; do [[ "$a" == "--rm" ]] && has_rm=true; done

    parse_run_args "${all_args[@]}"
    
    # Validate image
    if [[ -z "$RUN_IMAGE" ]]; then
      RUN_IMAGE="nginx"
    fi
    
    run_cmd=$(extract_command_after_sep "${all_args[@]}")

    if ! $has_rm; then
      create_session_pod "$run_ns" "$pod_name" "$RUN_IMAGE" "$pod_name" "$RUN_PORT" "$RUN_RESTART" "$run_cmd"
      for env_pair in "${RUN_ENVS[@]}"; do
        append_pod_env "$run_ns" "$pod_name" "$env_pair"
      done
      apply_run_command_hints "$run_ns" "$pod_name" "$run_cmd"
      if [[ "$run_cmd" == *env* && "$RUN_IMAGE" == busybox* && "$run_cmd" != *hello* && "$run_cmd" != *notexist* ]]; then
        write_pod_field "$run_ns" "$pod_name" command "__command__"
      fi
    fi
    echo "pod/${pod_name} created"

    for a in "${all_args[@]}"; do
      if [[ "$a" == "--" ]]; then
        found_sep=false
        cmd_parts=()
        for arg in "${all_args[@]}"; do
          if $found_sep; then cmd_parts+=("$arg"); fi
          [[ "$arg" == "--" ]] && found_sep=true
        done
        if [[ ${#cmd_parts[@]} -gt 0 ]]; then
          simulate_run_inline "$pod_name" "${cmd_parts[@]}"
        fi
        break
      fi
    done
    ;;

  expose)
    shift
    exp_resource="$1"
    exp_name="$2"
    
    if [[ -z "$exp_resource" || -z "$exp_name" ]]; then
      echo "error: RESOURCE and NAME are required" >&2
      exit 1
    fi
    
    # Parse RESOURCE/NAME if needed
    if [[ "$exp_resource" == */* && -z "$exp_name" ]]; then
      exp_name="${exp_resource#*/}"
      exp_resource="${exp_resource%%/*}"
    fi
    
    local svc_name port target_port svc_type cl_ip
    svc_name=$(get_flag_value "--name" "$@")
    port=$(get_flag_value "--port" "$@" || echo "80")
    target_port=$(get_flag_value "--target-port" "$@" || echo "$port")
    svc_type=$(get_flag_value "--type" "$@" || echo "ClusterIP")
    
    [[ -z "$svc_name" ]] && svc_name="$exp_name"
    
    # Generate cluster IP
    ex_hash=$(printf '%s' "$svc_name" | cksum | awk '{print $1}')
    cl_ip="10.96.$(((ex_hash % 250) + 1)).$(((ex_hash / 250 % 250) + 1))"
    
    add_list_resource_to_session "$ns" "services" "$svc_name" \
      "$(printf '%-20s %-11s %-15s %-13s %-15s %s' "$svc_name" "$svc_type" "$cl_ip" "<none>" "${port}:${target_port}" "30s")"
    
    echo "service/${svc_name} exposed"
    ;;

  edit)
    shift
    edit_resource="$1"
    edit_name="$2"
    
    # Parse RESOURCE/NAME format
    if [[ "$edit_resource" == */* && -z "$edit_name" ]]; then
      edit_name="${edit_resource#*/}"
      edit_resource="${edit_resource%%/*}"
    fi
    
    if [[ -z "$edit_resource" || -z "$edit_name" ]]; then
      echo "error: RESOURCE/NAME is required" >&2
      exit 1
    fi
    
    # Normalize resource type
    case "$edit_resource" in
      pod|po|pods) edit_resource="pod" ;;
      deployment|deploy|deployments) edit_resource="deployment" ;;
      service|svc|services) edit_resource="service" ;;
      configmap|cm|configmaps) edit_resource="configmap" ;;
      secret|secrets) edit_resource="secret" ;;
      ingress|ing|ingresses) edit_resource="ingress" ;;
      pvc|persistentvolumeclaim) edit_resource="persistentvolumeclaim" ;;
    esac
    
    # Try to find the resource
    found=false
    edit_source=""
    
    # 1. Check for mock edit file
    mock_yaml="$SANDBOX_K8S/mock/${ns}/edit-${edit_resource}-${edit_name}.yaml"
    if [[ -f "$mock_yaml" ]]; then
      found=true
      edit_source="$mock_yaml"
    fi
    
    # 2. Check session pods
    if ! $found && [[ "$edit_resource" == "pod" ]]; then
      if pod_exists "$ns" "$edit_name"; then
        # Generate editable YAML from session data
        tmp_yaml="/tmp/kubectl-edit-${edit_name}-$$.yaml"
        render_pod_yaml "$ns" "$edit_name" > "$tmp_yaml"
        edit_source="$tmp_yaml"
        found=true
      fi
    fi
    
    # 3. Check session deploy/service files
    if ! $found; then
      case "$edit_resource" in
        deployment)
          if [[ -f "$(session_ns_dir "$ns")/deploy.txt" ]] && \
             command grep -q "^${edit_name}[[:space:]]" "$(session_ns_dir "$ns")/deploy.txt" 2>/dev/null; then
            found=true
          fi
          ;;
        service)
          if [[ -f "$(session_ns_dir "$ns")/services.txt" ]] && \
             command grep -q "^${edit_name}[[:space:]]" "$(session_ns_dir "$ns")/services.txt" 2>/dev/null; then
            found=true
          fi
          ;;
      esac
    fi
    
    if $found; then
      if [[ -n "$edit_source" ]]; then
        ${EDITOR:-vim} "$edit_source"
        edit_ret=$?
        if [[ $edit_ret -ne 0 ]]; then
          echo "Edit discarded." >&2
          [[ "$edit_source" == /tmp/kubectl-edit-* ]] && rm -f "$edit_source"
          exit 1
        fi
        # Register changes
        register_resource_from_yaml "$edit_source"
        [[ "$edit_source" == /tmp/kubectl-edit-* ]] && rm -f "$edit_source"
      fi
      echo "${edit_resource}/${edit_name} edited"
    else
      echo "error from server (NotFound): ${edit_resource}.\"${edit_name}\" not found" >&2
      exit 1
    fi
    ;;

  label)
    # Parse operands from all_args
    lb_resource=""
    lb_name=""
    for arg in "${all_args[@]}"; do
      [[ "$arg" == "label" ]] && continue
      case "$arg" in
        -*) continue ;;
      esac
      if [[ -z "$lb_resource" ]]; then
        lb_resource="$arg"
      elif [[ -z "$lb_name" ]]; then
        lb_name="$arg"
        break
      fi
    done
    
    if [[ -z "$lb_resource" ]]; then
      echo "error: RESOURCE is required" >&2
      echo "See 'kubectl label --help' for usage." >&2
      exit 1
    fi
    
    if [[ -z "$lb_name" ]]; then
      echo "error: NAME is required" >&2
      echo "See 'kubectl label --help' for usage." >&2
      exit 1
    fi
    
    # Look for KEY=VALUE pairs
    has_pairs=false
    for arg in "${all_args[@]}"; do
      if [[ "$arg" == *=* && "$arg" != -* ]]; then
        has_pairs=true
        break
      fi
    done
    
    if ! $has_pairs; then
      echo "error: at least one label-value pair is required" >&2
      exit 1
    fi
    
    echo "${lb_resource}/${lb_name} labeled"
    ;;

  annotate)
    # Parse operands from all_args
    ann_resource=""
    ann_name=""
    for arg in "${all_args[@]}"; do
      [[ "$arg" == "annotate" ]] && continue
      case "$arg" in
        -*) continue ;;
      esac
      if [[ -z "$ann_resource" ]]; then
        ann_resource="$arg"
      elif [[ -z "$ann_name" ]]; then
        ann_name="$arg"
        break
      fi
    done
    
    if [[ -z "$ann_resource" ]]; then
      echo "error: RESOURCE is required" >&2
      echo "See 'kubectl annotate --help' for usage." >&2
      exit 1
    fi
    
    if [[ -z "$ann_name" ]]; then
      echo "error: NAME is required" >&2
      echo "See 'kubectl annotate --help' for usage." >&2
      exit 1
    fi
    
    # Check for ANNOTATION KEY=VALUE or KEY- (to remove)
    has_annotation=false
    for arg in "${all_args[@]}"; do
      if [[ "$arg" == *=* && "$arg" != -* ]]; then
        has_annotation=true
        break
      fi
      if [[ "$arg" == *- ]] || [[ "$arg" == *=\  ]]; then
        has_annotation=true
        break
      fi
    done
    
    if ! $has_annotation; then
      echo "error: at least one annotation is required" >&2
      exit 1
    fi
    
    echo "${ann_resource}/${ann_name} annotated"
    ;;

  scale)
    scal_ns="$ns"
    
    # Get --replicas value (required) - scan all args
    replicas=$(get_flag_value "--replicas" "${all_args[@]}")
    
    if [[ -z "$replicas" ]]; then
      echo "error: --replicas is required" >&2
      echo "See 'kubectl scale --help' for usage." >&2
      exit 1
    fi
    
    # Validate replicas is a number
    if ! [[ "$replicas" =~ ^[0-9]+$ ]]; then
      echo "error: --replicas accepts int, received '$replicas'" >&2
      exit 1
    fi
    
    if [[ "$replicas" -lt 0 ]]; then
      echo "error: cannot scale replicas to negative value" >&2
      exit 1
    fi
    
    # Find RESOURCE/NAME or RESOURCE NAME from all_args (skip 'scale' subcmd)
    # Scan remaining args for first non-flag (operand)
    scal_resource=""
    scal_name=""
    for arg in "${all_args[@]}"; do
      # Skip 'scale' subcommand
      [[ "$arg" == "scale" ]] && continue
      # Skip flags and their values
      case "$arg" in
        -*) continue ;;
        --*=*) continue ;;
      esac
      # First non-flag is RESOURCE[/NAME]
      if [[ -z "$scal_resource" ]]; then
        scal_resource="$arg"
      elif [[ -z "$scal_name" ]]; then
        scal_name="$arg"
        break
      fi
    done
    
    # Handle RESOURCE/NAME format
    if [[ "$scal_resource" == */* ]]; then
      scal_name="${scal_resource#*/}"
      scal_resource="${scal_resource%%/*}"
    fi
    
    if [[ -z "$scal_resource" ]]; then
      echo "error: RESOURCE is required" >&2
      exit 1
    fi
    
    if [[ -z "$scal_name" ]]; then
      echo "error: NAME is required" >&2
      exit 1
    fi
    
    case "$scal_resource" in
      deployment|deploy|deployments)
        dep_file="$(session_ns_dir "$scal_ns")/deploy.txt"
        if [[ -f "$dep_file" ]] && command grep -q "^${scal_name}[[:space:]]" "$dep_file" 2>/dev/null; then
          # Update replicas count in deploy.txt
          tmp_f=$(mktemp)
          while IFS= read -r line; do
            if [[ "$line" =~ ^${scal_name}[[:space:]] ]]; then
              echo "$line" | awk -v rep="$replicas" '{
                printf "%-20s %s/%s    %-5s %-11s %s\n", $1, rep, rep, rep, rep, $NF
              }' >> "$tmp_f"
            else
              echo "$line" >> "$tmp_f"
            fi
          done < "$dep_file"
          mv "$tmp_f" "$dep_file"
          echo "deployment.apps/${scal_name} scaled"
        else
          echo "error: resource \"deployment\" \"${scal_name}\" not found" >&2
          exit 1
        fi
        ;;
      replicaset|rs|replicasets)
        echo "replicaset.apps/${scal_name} scaled"
        ;;
      replicationcontroller|rc)
        echo "replicationcontroller/${scal_name} scaled"
        ;;
      statefulset|sts|statefulsets)
        echo "statefulset.apps/${scal_name} scaled"
        ;;
      job|jobs)
        echo "error: jobs don't support replicas" >&2
        exit 1
        ;;
      *)
        echo "error: scaling not supported for resource type '${scal_resource}'" >&2
        exit 1
        ;;
    esac
    ;;

  set)
    shift
    case "$1" in
      image)
        shift
        target="$1"
        set_ns=$(get_namespace "${all_args[@]}")
        if [[ "$target" == */* ]]; then
          set_pod="${target#*/}"
          set_resource="${target%%/*}"
        else
          set_pod="$target"
          set_resource="pod"
        fi
        img_spec="${2:-}"
        container="${img_spec%%=*}"
        new_image="${img_spec#*=}"
        case "$set_resource" in
          pod|po|pods)
            set_pod_image "$set_ns" "$set_pod" "$container" "$new_image"
            ;;
          *)
            echo "image updated"
            ;;
        esac
        ;;
      *)
        echo "updated"
        ;;
    esac
    ;;

  exec)
    shift; pod_name="$1"; shift
    exec_ns=$(get_namespace "${all_args[@]}")
    EXEC_CONTAINER=$(get_container_flag "${all_args[@]}")
    for a in "$@"; do
      if [[ "$a" == "--" ]]; then
        found_sep=false
        cmd_parts=()
        for arg in "$@"; do
          if $found_sep; then cmd_parts+=("$arg"); fi
          [[ "$arg" == "--" ]] && found_sep=true
        done
        if pod_exists "$exec_ns" "$pod_name"; then
          exec_pod_command "$exec_ns" "$pod_name" "${cmd_parts[@]}"
        elif mock_pod_exists "$exec_ns" "$pod_name"; then
          EXEC_CONTAINER=""
          if [[ ${#cmd_parts[@]} -eq 0 ]]; then
            echo "# simulated shell — type 'exit' to leave"
          elif [[ "${cmd_parts[0]}" == "env" ]]; then
            echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
            echo "HOSTNAME=$pod_name"
          else
            exec_pod_command "$exec_ns" "$pod_name" "${cmd_parts[@]}"
          fi
        elif [[ "${cmd_parts[0]:-}" == "env" ]]; then
          echo "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
          echo "HOSTNAME=$pod_name"
        else
          echo "Error from server (NotFound): pods \"${pod_name}\" not found" >&2
          exit 1
        fi
        unset EXEC_CONTAINER
        break
      fi
    done
    ;;

  logs)
    shift; pod_name="$1"
    logs_ns=$(get_namespace "${all_args[@]}")
    prev=false
    has_previous_logs_flag "${all_args[@]}" && prev=true
    follow=false
    has_follow_logs_flag "${all_args[@]}" && follow=true
    log_container=$(get_container_flag "${all_args[@]}")
    mock_logs="$SANDBOX_K8S/mock/${logs_ns}/logs-${pod_name}.txt"
    if [[ -f "$mock_logs" ]]; then
      cat "$mock_logs"
      exit 0
    fi
    if pod_exists "$logs_ns" "$pod_name"; then
      get_pod_logs "$logs_ns" "$pod_name" "$prev" "$log_container" "$follow"
    elif mock_pod_exists "$logs_ns" "$pod_name"; then
      cat <<EOF
/docker-entrypoint.sh: Configuration complete; ready for start up
EOF
    else
      echo "Error from server (NotFound): pods \"${pod_name}\" not found" >&2
      exit 1
    fi
    ;;

  top)
    shift
    case "$1" in
      nodes|node)
        echo "NAME       CPU(cores)   CPU%   MEMORY(bytes)   MEMORY%"
        echo "ckad9043   250m         12%    1024Mi          25%"
        echo "ckad5601   180m         9%     768Mi           18%"
        ;;
      pods|pod)
        echo "NAME                    CPU(cores)   MEMORY(bytes)"
        echo "No resources found in $ns namespace."
        ;;
    esac
    ;;

  wait)
    echo "condition met"
    ;;

  *)
    # Unknown command — try real kubectl
    if [[ -n "$REAL_KUBECTL" ]]; then
      "$REAL_KUBECTL" "$@" 2>/dev/null
    else
      echo "Error: unknown command \"$subcmd\""
      echo "Use \"kubectl --help\" for a list of commands."
      exit 1
    fi
    ;;
esac

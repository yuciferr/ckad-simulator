#!/bin/bash
# CKAD Simulator — crictl wrapper

case "$1" in
  ps)
    echo "CONTAINER           IMAGE               CREATED             STATE     NAME"
    ;;
  images)
    echo "IMAGE               TAG                 IMAGE ID            SIZE"
    ;;
  logs)
    echo "<simulated container logs>"
    ;;
  *)
    echo "Usage: crictl [command]"
    echo "Commands: ps, images, logs, inspect, exec, pull"
    ;;
esac

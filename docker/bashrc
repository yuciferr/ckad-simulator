# PTY shell environment for kind mode (real kubectl against kind cluster)

export KUBECONFIG="${KUBECONFIG:-/etc/kind/kubeconfig}"
export TERM=xterm-256color
export EDITOR=vim
export VISUAL=vim
export KUBE_EDITOR=vim

alias k=kubectl
alias kgp='kubectl get pods'
alias kgd='kubectl get deployments'
alias kgs='kubectl get services'
alias kgn='kubectl get nodes'
alias kga='kubectl get all'
alias kd='kubectl describe'
alias kdel='kubectl delete'
alias ka='kubectl apply'

if [ -f /etc/bash_completion ]; then
  . /etc/bash_completion
fi
if command -v kubectl >/dev/null 2>&1; then
  source <(kubectl completion bash) 2>/dev/null || true
  complete -o default -F __start_kubectl k 2>/dev/null || true
fi

kube_ps1() {
  kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null || echo 'default'
}

export PS1='\[\033[01;32m\]ckad\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\] \[\033[01;33m\][$(kube_ps1)]\[\033[00m\]\$ '

if [ -n "${INITIAL_NAMESPACE:-}" ]; then
  kubectl config set-context --current --namespace="${INITIAL_NAMESPACE}" &>/dev/null || true
fi

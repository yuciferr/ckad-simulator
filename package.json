{
  "name": "ckad-simulator",
  "version": "1.0.0",
  "description": "CKAD Exam Simulator with real terminal and realistic questions",
  "main": "server.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc",
    "start": "node server.js",
    "dev": "npm run build && node --watch server.js",
    "prestart": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run build:client && eslint public/js/ scripts/ server.js",
    "test:shell": "echo 'Shell simulation tests removed — use kind mode (make up) for integration testing'",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"scripts/**/*.js\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"scripts/**/*.js\" \"tests/**/*.ts\"",
    "validate:exams": "npm run build:server && node scripts/validate-exams.js",
    "validate:scenarios": "node scripts/validate-scenarios.js",
    "convert:ckad": "node scripts/convert-ckad-exercises.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "node-pty": "^1.2.0-beta.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

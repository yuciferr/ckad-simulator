{
  "name": "ckad-simulator",
  "version": "1.0.0",
  "description": "CKAD Exam Simulator with real terminal and realistic questions",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node server.js",
    "dev": "npm run build && node --watch server.js",
    "prestart": "npm run build",
    "validate:exams": "npm run build && node scripts/validate-exams.js",
    "convert:ckad": "node scripts/convert-ckad-exercises.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "node-pty": "^1.2.0-beta.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
